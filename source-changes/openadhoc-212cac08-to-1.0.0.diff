+        {
+            dst.tune_code[i] = src.tune_code[i]; dst.tune_color[i] = src.tune_color[i];
+            dst.tune_power[i] = src.tune_power[i]; dst.tune_weight[i] = src.tune_weight[i];
+            dst.susp_owned[i] = src.susp_owned[i]; dst.susp_tier[i] = src.susp_tier[i];
+            for (var j = 0; j < t; j++)
