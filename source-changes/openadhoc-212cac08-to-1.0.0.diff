+            {
+                var t = ROOT["Stage%d".format(i)]; var d = ROOT["StageDetail%d".format(i)];
+                if (i >= rows.size) { ROOT["StagePanel%d".format(i)].visible = false; t.visible = false; d.visible = false; continue; }
+                var y = self.list_top + i * 27;
+                self.setPanel(ROOT["StagePanel%d".format(i)], 18, y, 444, 25);
+                self.setRect(t, 30, y + 1, 420, 13); t.align = 3; t.text = "%s  %s".format(self.ordinal(i + 1), rows[i][0]);
+                self.setRect(d, 30, y + 11, 420, 13); d.text_color = grey;
