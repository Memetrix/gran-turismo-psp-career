+            else
+            {
+                // The price is always the price. A doubt about the buy takes the preview's label line (the part is
+                // already named on the row and the chosen stage in the cell beside it), the effect stays beside it,
+                // and the confirm dialog spells it out. A label used to replace the amount here (audit R4), and a
+                // note appended to the right cell pushed "Stage 3 +61%" out of its clipped width.
+                price.text = "%s Cr.".format(main::pdiext::MMisc::GetMoneyString(cand[1])); price.text_color = dark;
+                var note = nil;
+                if (!gain(parts, code, color, t, cand)) note = "No gain";
+                else { var cheaper = cheaperEqual(parts, list, t, stage, cand); if (cheaper != nil) note = "%s cheaper".format(info["stages"][cheaper[0]]); }
+                if (note != nil) { root["PreviewLabel"].T.text = note; price.text_color = faint; }
+            }
+    }
+
+    // Cursor only, inside the window: the row that lost focus and the row that gained it, plus the chip frame and
+    // the highlight. A move that leaves the window goes through drawWindow instead (move()).
+    function cursorTo(context, root, profile, prev)
+    {
+#ifdef CUP_SMOKE_AUTODRIVE
+        n_cursor = n_cursor + 1;
+#endif
+        var cp = main::GlobalStatus::game_context.getCar(); var code = cp.getCarCode(); var color = cp.color;
+        var parts = cachedParts(root, cp); var tune = main::Career::tuneFactors(code, color);
+        var weight = root.shop_stock == nil ? stockWeight(cp) : root.shop_stock[1];
+        hint_word = "Buy"; focus_chip = -1; focus_y = 0;
+        if (prev != row) drawRow(context, root, cp, code, color, parts, tune, weight, prev, prev - first_type);
+        drawRow(context, root, cp, code, color, parts, tune, weight, row, row - first_type);
+        finishCursor(root);
+    }
+
+
+    // The one text a full journal gets on this page, from the check before the buy dialog and from a refused fit.
+    function recordsNote(context)
+    { note(context, "All %d tuning records are in use.\nRemoving parts keeps them owned, so it frees nothing.\nSelling the last copy of a tuned car frees its record.".format(main::Career::RECORDS_MAX)); }
+
+    // Would Career::tuneSlot(code, color, true) find this car and colour a record? It has one already, a record is
+    // free, or the journal can still grow by a block (growTo stops at RECORDS_MAX).
+    function recordAvailable(code, color)
+    {
+        if (main::Career::tuneSlot(code, color, false) >= 0 || main::Career::tuneCap() < main::Career::RECORDS_MAX) return true;
+        var s = main::Career::get();
+        for (var i = 0; i < main::Career::tuneCap(); i++) if (s.tune_code[i] == -1) return true;
+        return false;
+    }
+
+    function fitCandidate(context, parts, cp, code, color, type, stage)
+    {
+        var candidate = CareerNativeTurbo::prepare(parts, cp, type, stage);
+        if (candidate == nil)
+        { note(context, "Unable to prepare this part.\nYour credits and purchases are unchanged."); return false; }
+        if (!CareerProgress::fit(parts, candidate, code, color, type, stage)) { recordsNote(context); return false; }
+        return true;
+    }
+
+    // Rebuilding every preview after a fit takes several rendered frames on a full journal. Keep the old shop
+    // covered until its names, prices and cursor have all been redrawn, including a free refit or a removal.
+    function refreshWithWait(context, root)
+    {
+        main::DialogUtil::openConfirmExecDialog(context, nil, "Applying upgrade...", nil, nil,
+            function (context, page) { page.refresh(context); return true; }, root, nil);
+    }
+
+    // One installed aspiration device at a time (CareerProgress::aspiration): fitting a turbo kit, an NA tune
+    // or a supercharger removes whichever of the other two is on the car, and that part stays owned.
+    function replacementNotice(code, color, type)
+    {
+        if (!CareerProgress::aspiration(type)) return "";
+        var others = [0, 1, 9]; var names = main::CareerParts::types;
+        foreach (var o in others)
+            if (o != type && CareerProgress::tuneStage(code, color, o) > 0)
+                return "\n%s will be removed; it stays owned.".format(names[main::CareerParts::order[o]]["name"]);
+        return "";
+    }
+
+    function buy(context, root, profile)
+    {
+        var cp = main::GlobalStatus::game_context.getCar(); var code = cp.getCarCode(); var color = cp.color; var t = row;
+        var parts = cachedParts(root, cp); var list = stageList(parts, t);
+        var stage = CareerProgress::tuneStage(code, color, t);
+        var info = main::CareerParts::types[main::CareerParts::order[t]];
+        var cand = candidate(list, t, stage);
+        if (cand == nil || cand[0] == stage) { main::sound.play("cancel"); return; }
+        if (CareerProgress::owns(code, color, t, cand[0]))
+        {
+            if (!main::DialogUtil::openConfirmDialog(context, main::DialogUtil::YESNO, "Fit %s?\nAlready owned: no charge.%s".format(partName(info, cand[0]), replacementNotice(code, color, t)))) return;
+            if (!fitCandidate(context, parts, cp, code, color, t, cand[0])) return;
+            dirty = true; pick[t] = 0; dropCaches(root);
+            main::sound.play("ok");
+            refreshWithWait(context, root);
+            return;
+        }
+        if (!adds(root, parts, cp, code, color, t, cand, main::Career::tuneFactors(code, color)))
+        { note(context, "Engine tuning limit reached.\n%s would add no power beyond +100%%.".format(partName(info, cand[0]))); return; }
