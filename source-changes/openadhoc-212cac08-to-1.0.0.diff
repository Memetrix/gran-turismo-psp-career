diff -ruN a/scripts/gt5m/CareerCatalog.ad b/scripts/gt5m/CareerCatalog.ad
--- a/scripts/gt5m/CareerCatalog.ad	1970-01-01 00:00:00.000000000 +0000
+++ b/scripts/gt5m/CareerCatalog.ad	2026-09-30 11:51:52.283311557 +0000
@@ -0,0 +1,161 @@
+// Generated by scripts/build_career_catalog.py. No tables live here on purpose (memory rules, CLAUDE.md):
+// halls and events are read on demand from textdata/career/index/ into temporaries, eligible-car lists from
+// textdata/career/events/ and textdata/career/entry/. Strings in this VM have split() but no indexOf()
+// (calling a missing method crashes the game): compare items.
+module ::main::CareerCatalog
+{
+    static HALLS = 9;
+    static EVENTS = 333;
+    // Плотный индекс блоков чемпионата в журнале: столько блоков, а не по одному на событие.
+    static SERIES_SLOTS = 133;
+    // Temporary diagnostic events. They are real events with real ids, but nothing they record may count as
+    // career progress, so goldTotal skips them. Empty in a normal build; generated, never hand-edited.
+    static TEST_EVENTS = [ 111, 112 ];
+    // The retail GT4 events (ids PRIZE_ONCE_FIRST..PRIZE_ONCE_LAST) hand their prize car out for the first win only,
+    // as GT4 does; the career's own events repeat theirs (26.09, farm found by the career simulation).
+    static PRIZE_ONCE_FIRST = 200;
+    static PRIZE_ONCE_LAST = 332;
+
+    function readText(path)
+    {
+        var f = main::pdistd::ReadFile(path);
+        if (f == nil || f["result"] != 0) return "";
+        return f["buffer"].toString();
+    }
+    // Hall h as a temporary map: key, name, art, events (ids), gate_gold (gold stages needed to enter, 0 = open).
+    function hallInfo(h)
+    {
+        var f = readText("textdata/career/index/hall-%d.txt".format(h)).split("|");
+        // A missing or truncated file must never be indexed blind: show a hall that cannot be entered rather than kill
+        // the VM on a short array (audit F13).
+        if (f.size < 7) return [ "key": "", "name": "DATA ERROR", "art": "beginner", "events": [], "heads": [], "tails": [], "gate_gold": 0, "valid": false ];
+        var events = [];
+        // An id outside the catalog would index the journal's tables blind: dropped here, never passed on (review F1).
+        foreach (var e in f[3].split(",")) if (e != "") { var id = e.toInt(); if (id >= 0 && id < EVENTS) events.push(id); }
+        // `events` - всё, что зал содержит; `heads` - то, что он ПОКАЗЫВАЕТ. Продолжения длинного соревнования
+        // живут внутри него, а не рядом: донор показывает 18 эндуранс-соревнований, и разрезание на части не
+        // должно превращать их в 52 карточки.
+        // `tails` идёт ПАРАЛЛЕЛЬНО `heads` (чей флаг cleared решает соревнование), поэтому они разбираются парой:
+        // отброшенный id в одном списке не должен сдвинуть другой.
+        var heads = []; var tails = [];
+        var hs = f[5].split(","); var ts = f[6].split(",");
+        if (hs.size == ts.size)
+        {
+            for (var j = 0; j < hs.size; j++)
+            {
+                if (hs[j] == "" || ts[j] == "") continue;
+                var hid = hs[j].toInt(); var tid = ts[j].toInt();
+                if (hid >= 0 && hid < EVENTS && tid >= 0 && tid < EVENTS) { heads.push(hid); tails.push(tid); }
+            }
+        }
+        return [ "key": f[0], "name": f[1], "art": f[2], "events": events, "heads": heads, "tails": tails, "gate_gold": f[4].toInt(),
+                 "valid": f[0] != "" && events.size > 0 && heads.size > 0 ];
+    }
+    // Event id as a temporary map: key, name, hall, rule, eligible_count, sample, prize ("" = cash only), completion_bonus,
+    // ai_skill, art, opponents ([label, torque-volume percent, PP]), stages (course, name, laps, logo, prizes[4], minutes),
+    // licence (PSP Driving Challenge category index or -1), series (1 = points championship in GT4), list_key (rules-page
+    // list: the event key or "all"), pp_lo / pp_hi (opponent class window), tire (player tyre category),
+    // power_max / power_min / weight_max (limits on the car as entered, 0 when the event has none - audit F07),
+    // prize_color (the prize car's VARIATION index: the colour it is delivered in and its thumbnail .NN).
+    function eventInfo(id)
+    {
+        var f = readText("textdata/career/index/event-%d.txt".format(id)).split("|");
+        // `valid` is the one flag callers gate on (audit R7): a short file, an empty key, a stage or an opponent with
+        // fields missing, or no stages at all, and the record can be shown as DATA ERROR but not opened, started,
+        // or claimed. Malformed entries are skipped rather than indexed blind.
+        if (f.size < 29) return [ "key": "", "name": "DATA ERROR", "hall": 0, "rule": "", "eligible_count": 0, "sample": "",
+                                  "prize": "", "prize_color": 0, "completion_bonus": 0, "ai_skill": 50, "art": "beginner", "opponents": [],
+                                  "stages": [], "licence": -1, "series": 0, "list_key": "all", "pp_lo": 0, "pp_hi": 0, "tire": 105,
+                                  "power_max": 0, "power_min": 0, "weight_max": 0, "series_slot": -1, "requires": -1, "continues": -1, "chain_last": -1, "chain_parts": [], "chain_stages": 0, "marathon_slot": -1, "marathon_prizes": [0,0,0,0], "valid": false ];
+        var valid = f[0] != "";
+        var opponents = [];
+        foreach (var o in f[10].split(",")) if (o != "") { var q = o.split(":"); if (q.size < 3) { valid = false; continue; } opponents.push([q[0], q[1].toInt(), q[2].toInt()]); }
+        var parts = [];
+        foreach (var q in f[25].split(",")) if (q != "") { var pid = q.toInt(); if (pid >= 0 && pid < EVENTS) parts.push(pid); }
+        var stages = [];
+        var marathon_prizes = [];
+        foreach (var p in f[28].split(":")) marathon_prizes.push(p.toInt());
+        if (marathon_prizes.size != 4) valid = false;
+        foreach (var s in f[11].split(";"))
+        {
+            var g = s.split(",");
+            if (g.size < 6) { valid = false; continue; }
+            var prizes = [];
+            foreach (var p in g[4].split(":")) prizes.push(p.toInt());
+            if (prizes.size < 4) { valid = false; continue; }
+            stages.push([ "course": g[0], "name": g[1], "laps": g[2].toInt(), "logo": g[3], "prizes": prizes, "minutes": g[5].toInt() ]);
+        }
+        if (stages.size == 0 || stages.size > 6) valid = false;
+        return [ "key": f[0], "name": f[1], "hall": f[2], "rule": f[3], "eligible_count": f[4].toInt(), "sample": f[5], "sample_miss": f.size > 29 ? f[29] : "", "prize": f[6],
+                 // The prize car's colour (VARIATION index, thumbnail .NN); 0 in a record older than the field (27.09).
+                 "prize_color": f.size > 30 ? f[30].toInt() : 0,
+                 "completion_bonus": f[7].toInt(), "ai_skill": f[8].toInt(), "art": f[9], "opponents": opponents, "stages": stages,
+                 "licence": f[12].toInt(), "series": f[13].toInt(), "list_key": f[14], "pp_lo": f[15].toInt(), "pp_hi": f[16].toInt(), "tire": f[17].toInt(),
+                 "power_max": f[18].toInt(), "power_min": f[19].toInt(), "weight_max": f[20].toInt(),
+                 // Индекс блока чемпионата в журнале, -1 у события без серии. Плотный: блоков столько, сколько
+                 // чемпионатов, а не сколько событий. Едет со строкой каталога, чтобы путь завершения гонки
+                 // не читал каталог с диска.
+                 "series_slot": f[21].toInt(),
+                 // Идентификатор предыдущего звена цепочки, -1 у самостоятельного события и у первой части.
+                 // Длинное соревнование не влезает в одно событие (шаг журнала шесть этапов), поэтому едет
+                 // цепочкой; это поле - единственное, что делает её цепочкой, а не набором похожих событий.
+                 "requires": f[22].toInt(),
+                 // Следующее звено, -1 у последнего. Цепочка связана в обе стороны: назад - чтобы запереть
+                 // часть, вперёд - чтобы новый заезд соревнования сбрасывал ВСЕ его части, а не одну.
+                 "continues": f[23].toInt(),
+                 // Последнее звено цепочки, -1 у самостоятельного события. Голова по нему понимает, кончилось
+                 // ли соревнование: у неё самой раунды кончаются после первой части, а соревнование - нет.
+                 "chain_last": f[24].toInt(),
+                 // Все части цепочки (голова - первая) и общее число этапов - у КАЖДОГО звена; пусто и ноль у
+                 // одиночного события. Страница частей открывается одним чтением вместо двенадцати.
+                 "chain_parts": parts, "chain_stages": f[26].toInt(),
+                 // Слот марафона в журнале (итог пройденного пути четверых) или -1: у всего, что не эндуранс.
+                 "marathon_slot": f[27].toInt(), "marathon_prizes": marathon_prizes, "valid": valid ];
+    }
+    // Только поле requires, без разбора этапов и соперников: обход цепочки зовёт это по звену, а полный
+    // eventInfo строит два массива на каждый вызов. Короткий или битый файл выдаёт -1, то есть «конец цепочки»,
+    // и обход останавливается вместо того, чтобы индексировать журнал вслепую.
+    function requiresOf(id)
+    {
+        if (id < 0 || id >= EVENTS) return -1;
+        var f = readText("textdata/career/index/event-%d.txt".format(id)).split("|");
+        if (f.size < 23) return -1;
+        var r = f[22].toInt();
+        return (r >= 0 && r < EVENTS && r != id) ? r : -1;
+    }
+    function eligible(id, code) {
+        if (code == main::gtengine::MSpecDB::NO_CODE64) return false;
+        var label = main::gtengine::MSpecDB::getCarLabel(code); var key = eventInfo(id)["key"];
+        foreach (var k in readText("textdata/career/entry/%s.txt".format(label)).split(",")) if (k == key) return true;
+        return false;
+    }
+    // Page `page` (six labels) of the event's eligible cars for the rules page; a temporary array.
+    function eligiblePage(id, page) {
+        var out = [];
+        foreach (var label in readText("textdata/career/events/%s-%d.txt".format(eventInfo(id)["list_key"], page)).split(",")) if (label != "") out.push(label);
+        return out;
+    }
+    function hallOf(id) {
+        var key = eventInfo(id)["hall"];
+        for (var h = 0; h < HALLS; h++) if (hallInfo(h)["key"] == key) return h;
+        return 0;
+    }
+    // Позиция карточки события в зале. Зал показывает головы соревнований, поэтому часть цепочки ищется по
+    // своей голове: из части Back ведёт к карточке всего соревнования, а не в начало зала.
+    function indexIn(id) {
+        var parts = eventInfo(id)["chain_parts"]; var head = parts.size > 0 ? parts[0] : id;
+        var list = hallInfo(hallOf(id))["heads"];
+        for (var i = 0; i < list.size; i++) if (list[i] == head) return i;
+        return 0;
+    }
+    function prizeOnce(id) { return id >= PRIZE_ONCE_FIRST && id <= PRIZE_ONCE_LAST; }
+    // Career races carry the title "AAHEAD_CAREER_<event>_<stage>" (CareerRoot.startRace): no table lookup needed.
+    function find(title) {
+        if (title == nil || !title.beginWith("AAHEAD_CAREER_")) return nil;
+        var p = title.split("_");
+        if (p.size != 4) return nil;
+        var e = p[2].toInt(); var r = p[3].toInt();
+        if (e < 0 || e >= EVENTS || r < 0 || r >= main::Career::STAGES) return nil;
+        return [e, r];
+    }
+}
diff -ruN a/scripts/gt5m/CareerMarket.ad b/scripts/gt5m/CareerMarket.ad
