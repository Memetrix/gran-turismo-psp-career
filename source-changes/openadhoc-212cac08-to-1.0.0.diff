+    method locate(id)
+    {
+        self.category = main::CareerCatalog::hallOf(id); self.hall_start = (self.category / 4) * 4;
+        var i = main::CareerCatalog::indexIn(id);
+        self.page_start = (i / 4) * 4; self.selected = i - self.page_start;
