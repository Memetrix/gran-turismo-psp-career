+            // career asks "is this claimed?". Out of range in either direction is a refusal. `cleared` 2 is a won event
+            // whose prize car was won again (it resells for a tenth), 3 a won event that has not handed its car out yet
+            // (CareerProgress.claim).
+            if (c.cycles[i] < 0 || c.claimed[i] < 0 || c.claimed[i] > 1 || c.cleared[i] < 0 || c.cleared[i] > 3) return false;
+        if (c.attempt < c.last_receipt || c.last_receipt < 0) return false;
+        return true;
+    }
