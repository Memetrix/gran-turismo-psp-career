+    method refreshCarList(context)
+    {
+        var e = main::CareerCatalog::eventInfo(self.event_id);
+        if (self.list_offset < 0)
+        {
+            // Лист STANDINGS марафона (см. marathonTable): зачёт по всей цепочке и путь каждого за заезд.
