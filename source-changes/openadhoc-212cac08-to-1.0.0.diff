diff -ruN a/projects/gt5m/race/CareerRunway.ad b/projects/gt5m/race/CareerRunway.ad
--- a/projects/gt5m/race/CareerRunway.ad	1970-01-01 00:00:00.000000000 +0000
+++ b/projects/gt5m/race/CareerRunway.ad	2026-09-30 11:51:52.234078360 +0000
@@ -0,0 +1,57 @@
+// Endurance progress from the PSP course's RNW4 centreline. Included only in
+// ModuleArcade: no geometry or parsed catalog object stays resident at boot.
+// The generator writes decimetres to textdata/career/runway/<course>.txt.
+module CareerRunway
+{
+    // World coordinates for the four race slots -> four phases along the
+    // native TrackV axis, in whole metres. nil means a missing/corrupt map or
+    // a car farther than 500 m from the runway; callers must not award a result.
+    function projectFour(label, positions)
+    {
+        var file = main::pdistd::ReadFile("textdata/career/runway/%s.txt".format(label));
+        if (file == nil || file["result"] != 0) return nil;
+        var tokens = file["buffer"].toString().split(";"); file = nil;
+        if (tokens.size < 3 || positions.size != 4) return nil;
+        var length = tokens[0].toFloat() * 0.1;
+        if (length < 100.0) return nil;
+        var best = [250000.0, 250000.0, 250000.0, 250000.0];
+        var phases = [-1, -1, -1, -1];
+        var a = tokens[tokens.size - 1].split(",");
+        if (a.size != 4) return nil;
+        for (var i = 1; i < tokens.size; i++)
+        {
+            var b = tokens[i].split(",");
+            if (b.size != 4) return nil;
+            var ax = a[0].toFloat() * 0.1; var ay = a[1].toFloat() * 0.1; var az = a[2].toFloat() * 0.1;
+            var dx = b[0].toFloat() * 0.1 - ax;
+            var dy = b[1].toFloat() * 0.1 - ay;
+            var dz = b[2].toFloat() * 0.1 - az;
+            var squared = dx * dx + dy * dy + dz * dz;
+            var va = a[3].toFloat() * 0.1;
+            var dv = b[3].toFloat() * 0.1 - va;
+            if (dv < 0.0) dv += length;
+            if (squared > 0.01)
+                for (var k = 0; k < 4; k++)
+                {
+                    var p = positions[k];
+                    var t = ((p[0] - ax) * dx + (p[1] - ay) * dy + (p[2] - az) * dz) / squared;
+                    if (t < 0.0) t = 0.0;
+                    if (t > 1.0) t = 1.0;
+                    var ex = p[0] - ax - t * dx;
+                    var ey = p[1] - ay - t * dy;
+                    var ez = p[2] - az - t * dz;
+                    var error = ex * ex + ey * ey + ez * ez;
+                    if (error < best[k])
+                    {
+                        best[k] = error;
+                        var phase = va + t * dv;
+                        if (phase >= length) phase -= length;
+                        phases[k] = phase.toInt();
+                    }
+                }
+            a = b;
+        }
+        for (var s = 0; s < 4; s++) if (phases[s] < 0 || best[s] >= 250000.0) return nil;
+        return phases;
+    }
+}
