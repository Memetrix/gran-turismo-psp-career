+        releaseSlot(slot);
+        s.tune_code[slot] = code; s.tune_color[slot] = color;
+        return slot;
+    }
+
+    function releaseSlot(i)
+    {
+        var s = get();
+        if (i < 0 || i >= s.tune_cap) return;
