+                        main::Career::setRunPos(id, r, 1);
+                        for (var k = 0; k < main::Career::SERIES_RIVALS; k++) main::Career::setRivalPos(id, k, r, k + 2);
+                    }
+                    stages++;
+                }
+                if (e["series"] == 1) CareerProgress::setRivals(id, [0, 1, 2]);
+                if (e["continues"] < 0) { s.cleared[id] = 1; s.claimed[id] = 1; titles++; }
+                events++; e = nil;
