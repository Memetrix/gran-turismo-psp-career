+        var total = e["eligible_count"];
+        var cars = main::CareerCatalog::eligiblePage(self.event_id, self.list_offset / 6);
+        var last = self.list_offset + cars.size;
+        Counter.visible = true; Counter.text = "%d-%d / %d".format(self.list_offset + 1, last, total);
+        for (var i = 0; i < 6; i++)
+        {
+            var row = ROOT["Stage%d".format(i)]; var index = i; var show = index < cars.size;
