+            self.tipHall(context);
+        }
+        else if (self.page == 1)
+        {
+            var list = main::CareerCatalog::hallInfo(self.category)["heads"]; var shown = list.size - self.page_start; if (shown > 4) shown = 4;
+            for (var i = 0; i < shown; i++)
+            {
+                var f = ROOT["CardFrame%d".format(i)];
+                if (i == self.selected) f.visible = false; else self.setFrame(f, 17 + (i % 2) * 226, 45 + (i / 2) * 95, 218, 78);
