@@ -0,0 +1,42 @@
+// Generated by scripts/build_career_parts.py from GT4 (USA) part tables.
+// The per-car catalog is NOT resident: scripts/build.py writes design/career-parts.json as textdata/career/parts/<label>.txt
+// (one line per car: type=stage,price,effect;...|type=...; effect: engine percent, 100 = stock, or weight in tenths of percent)
+// and forCar() reads one file on demand. Keeping 705 cars in script memory cost the race its 6.9 MB arena (v0.3.1 test).
+module ::main::CareerParts
+{
+    static types = [ "turbo": [ "name": "Turbo Kit", "stages": [ "", "Stage 1", "Stage 2", "Stage 3", "Stage 4", "Tuner" ] ], "natune": [ "name": "NA Tune", "stages": [ "", "Stage 1", "Stage 2", "Stage 3" ] ], "muffler": [ "name": "Exhaust", "stages": [ "", "Sports", "Semi-Racing", "Racing" ] ], "computer": [ "name": "Sports ECU", "stages": [ "", "Sports" ] ], "intercooler": [ "name": "Intercooler", "stages": [ "", "Sports", "Racing" ] ], "portpolish": [ "name": "Port Polish", "stages": [ "", "Port Polish" ] ], "weight": [ "name": "Weight Reduction", "stages": [ "", "Stage 1", "Stage 2", "Stage 3" ] ], "enginebalance": [ "name": "Engine Balance", "stages": [ "", "Balancing" ] ], "displacement": [ "name": "Displacement", "stages": [ "", "Bore Up" ] ], "supercharger": [ "name": "Supercharger", "stages": [ "", "Kit" ] ] ];
+    // The journal type index (Career::TUNE_TYPES): append only, never reorder. 7..9 are the engine work of v12.
+    static order = [ "turbo", "natune", "muffler", "computer", "intercooler", "portpolish", "weight", "enginebalance", "displacement", "supercharger" ];
+    // Tyres are not one of the seven tuning types: a grade is bought and worn, it has no stage ladder. Each
+    // entry is [category 100..110, price, grip Mu]; the first three are free in the donor and here,
+    // and the last two are dirt and snow.
+    static tire_short = [ "N1", "N2", "N3", "S1", "S2", "S3", "R1", "R2", "R3", "DT", "SN" ];
+    static tire_long = [ "Normal 1", "Normal 2", "Normal 3", "Sports Hard", "Sports Medium", "Sports Soft", "Racing Super Hard", "Racing Hard", "Racing Medium", "Dirt", "Snow" ];
+    // No cache on purpose: objects held by a global-module static after boot keep their heap page alive,
+    // and a page allocated while the career screen initialised then blocks the race arena
+    // (docs/TUNING-RESEARCH.md, memory investigation). Callers fetch once per refresh into a local.
+    function forCar(code)
+    {
+        var parts = [:];
+        var file = main::pdistd::ReadFile("textdata/career/parts/%s.txt".format(main::gtengine::MSpecDB::getCarLabel(code)));
+        var buf = file != nil && file["result"] == 0 ? file["buffer"] : nil;
+        if (buf != nil)
+        {
+            var packed = buf.toString();
+            buf = nil; file = nil;
+            foreach (var group in packed.split("|"))
+            {
+                |var key, var stages| = group.split("=");
+                var list = [];
+                foreach (var stage in stages.split(";"))
+                {
+                    var values = [];
+                    foreach (var field in stage.split(",")) values.push(field.toInt());
+                    list.push(values);
+                }
+                parts[key] = list;
+            }
+        }
+        return parts;
+    }
+}
diff -ruN a/scripts/gt5m/CareerState.ad b/scripts/gt5m/CareerState.ad
--- a/scripts/gt5m/CareerState.ad	1970-01-01 00:00:00.000000000 +0000
+++ b/scripts/gt5m/CareerState.ad	2026-09-30 11:51:52.283436457 +0000
@@ -0,0 +1,824 @@
+// Shared across projects. Serialized inside the native save wrapper's journal.
+// Version 2 adds per-car tuning records (GT4 part stages applied as engine ratios).
+// Version 3 adds the owned-part mask per car and type: bought bolt-on parts stay in the inventory when unfitted.
+// Version 4 widens the event tables from 10 to EVENTS (wave 1: 23 events, up to 5 stages each).
+// Versions 5..8 add the wider event capacity, the championship block, the catalog epoch and the suspension kits.
+// Version 9 stops writing a fixed 32 x 7 block of tuning records: the header carries the record capacity and the
+// two strides, so the journal is as long as the career actually is and a new part type needs no new version.
+// Version 12 (2026-09-21) widens the type stride from 7 to 10: engine balance, displacement and supercharger are
+// part types 7, 8 and 9. Same policy as every bump since 20.09: no migration, an older journal resets with a dialog.
+// Version 14 locks one player car to a running championship or marathon. Version 13 is migrated, including all
+// results and purchases; its already-raced rounds have no car identity, so the next confirmed round establishes it.
+module ::main::Career
+{
+#ifdef CAREER_E2
+    // Experiment E2: does a setting written on the prepared copy reach the car the race actually drives?
+    // Four scalars, one build per value, nothing resident in a release (the define is injected only by --e2).
+    // The chain is: what startRace asked for -> what the prepared copy reads back -> what ModuleArcade reads from
+    // RaceOperator.getTargetCarParameter(0) as the race loads. All three of spring, ride and final gear are read at
+    // both ends, so one run also shows that the fields nobody touched came through unchanged.
+    static e2_want = -1;          // the value this build writes
+    static e2_copy_spring = -1; static e2_copy_ride = -1; static e2_copy_final = -1; static e2_copy_power = -1;
+    static e2_race_spring = -1; static e2_race_ride = -1; static e2_race_final = -1; static e2_race_power = -1;
+    static e2_race_seen = 0;      // ModuleArcade ran and read the race instance
+#endif
+    static state = nil;
+    // Deferred until the arcade module is loaded: catalog parsing must not become boot-resident code.
+    static susp_needs_normalise = true;
+    static native_needs_normalise = true;
+    static return_event = -1;
+    static last_claim_bonus = 0;
+    static pending_series = 0;       // set by CareerRoot.startRace; the race-end path must not read the catalog from disk
+    static pending_player_slot = 3;  // the player's grid index of the race being started, so the result path needs no engine call
+    // Слот грида -> кто на нём стоит, упакованное в ЧИСЛО: по три бита на слот (0 - не задано, 1 - игрок,
+    // иначе индекс соперника плюс два). До цепочек соперники стояли на гриде строго по своему индексу и путь
+    // конца гонки вычислял его арифметикой от слота игрока; расстановка по общему зачёту эту арифметику
+    // ломает, поэтому отображение задаётся на старте и читается на финише.
+    // ЧИСЛОМ, а не массивом: это статик РЕЗИДЕНТНОГО модуля, и держать здесь объект, созданный страницей
+    // аркады, значит завести резидентную ссылку в её память - ровно то, что запрещают правила памяти.
+    // Битовых операторов в этом VM нет, поэтому раскладка арифметикой, как у hasBit.
+    static SLOT_BASE = [1, 8, 64, 512];
+    static pending_rival_slot = 0;
+    static pending_car_slot = -1; static pending_car_code = -1; static pending_car_color = 0;
+    static last_claim_car = false;   // the last claim added the prize car (false: cash-only event or a copy already owned)
+    // Марафон (соревнование эндуранс-зала - одна донорская гонка, нарезанная на отрезки). Ставит CareerRoot.startRace,
+    // читает сторона гонки, которая каталог с диска не читает. Всё - ЧИСЛА: это статики резидентного модуля, и
+    // объект страницы здесь удержал бы её пул (22.09 так перестали стартовать гонки).
+    static pending_marathon = -1;   // слот марафона стартующей гонки карьеры, -1 - не марафон
+    static stint_done = 0;          // этот отрезок уже засчитан: второй старт с предгоночного экрана запрещён
+    // Пройденный путь по слотам гонки, в метрах, снятый в момент конца гонки: мгновенный повтор запускается ДО
+    // записи результата карьеры, и читать живые счётчики после него ненадёжно (complete-contract-20260922).
+    static stint_m0 = 0; static stint_m1 = 0; static stint_m2 = 0; static stint_m3 = 0;
+    static stint_metric = 0; static stint_capture = 0; static stint_length = 0; static stint_final = 0;
+    static stint_start0 = 0; static stint_start1 = 0; static stint_start2 = 0; static stint_start3 = 0;
+    // Ёмкость журнала = события каталога (207 после продолжений) ПЛЮС резерв в два идентификатора, которых у
+    // каталога нет и не будет. На них фикстура проверяет, что читатель переживает отсутствующую и битую
+    // запись: идентификатор проходит проверку диапазона и доходит до чтения файла. Раньше такие числа просто
+    // брались свободными (165, 169, 170 при 170 событиях), и продолжения длинных событий сделали их
+    // Нюрбургрингом - смоук-сборка начала затирать настоящую вторую часть, а проверки диапазона перестали
+    // проверять. Резерв стоит 2 x 33 = 66 байт базы и делает такой идентификатор существующим по построению.
+    static EVENTS = 335;
+    static RESERVED = 2;     // последние RESERVED идентификаторов - только для фикстур, каталог их не занимает
+    static EVENTS_V4 = 40;
+    static SERIES_RIVALS = 3;                 // fixed rival trio of a championship cycle
+    static POINTS = [10, 8, 6, 4];            // user decision 5: 10 / 8 / 6 / 4, ties by wins, then by the last round
+    static STAGES = 6;       // stage stride of the v4 tables (Hot Rod Competition has six races); v1..v3 used 5
+    static TUNE_TYPES = 10;  // turbo, natune, muffler, computer, intercooler, portpolish, weight, enginebalance, displacement, supercharger (CareerParts::order)
+    // The highest catalog stage of each type (build_career_parts.py STAGE_NAMES): a stage above it in a file is a
+    // corrupt journal, not a purchase.
+    static STAGE_MAX = [5, 3, 3, 1, 2, 1, 3, 1, 1, 1];
+    // Frozen shape of the v2..v8 layouts. Their serialized sizes are in LAYOUT_SIZES and saves written with them are
+    // still on cards, so these two numbers are history: TUNE_TYPES above may grow, TUNE_TYPES_V8 may not.
+    static TUNE_SLOTS_V8 = 32;
+    static TUNE_TYPES_V8 = 7;
+    static STAGE_BIT = [1, 2, 4, 8, 16];   // owned-mask value of stages 1..5 (arithmetic, no bit operators needed)
+
+
+
+    // Everything after magic and version. v9 puts three more header fields between them and this block, so the two
+    // parts are defined separately; the order of define() calls is the order of the bytes.
+    function defineTableBody(st, n, stride)
+    {
+        st.define("medals", STArray(STByte(), n * stride));
+        st.define("best", STArray(STByte(), n * stride));
+        st.define("cycles", STArray(STInt(), n));
+        st.define("claimed", STArray(STByte(), n));
+        st.define("cleared", STArray(STByte(), n));
+        st.define("attempt", STInt());
+        st.define("last_receipt", STInt());
+    }
+
+
+
+    function initCommon(s) { initTables(s, 10, 5); }
+
+    function initTables(s, n, stride)
+    {
+        initTableBody(s, n, stride);
+        for (var i = 0; i < TUNE_SLOTS_V8; i++) { s.tune_code[i] = -1; s.tune_color[i] = 0; s.tune_power[i] = 0; s.tune_weight[i] = 100; }
+        for (var i = 0; i < TUNE_SLOTS_V8 * TUNE_TYPES_V8; i++) s.tune_stage[i] = 0;
+    }
+
+    function initTableBody(s, n, stride)
+    {
+        s.magic = 1129664595;
+        for (var i = 0; i < n * stride; i++) { s.medals[i] = 0; s.best[i] = 0; }
+        for (var i = 0; i < n; i++) { s.cycles[i] = 0; s.claimed[i] = 0; s.cleared[i] = 0; }
+        s.attempt = 0; s.last_receipt = 0;
+    }
+
+
+
+
+    // Championship runner (journal v6). One byte array, one block of SERIES_BLOCK bytes per event:
+    //   [0 .. STAGES)                                  the player's finishing position per round (0 = not raced)
+    //   [STAGES .. STAGES + SERIES_RIVALS)             the fixed rival trio as pool index + 1 (0 = not drawn yet)
+    //   the rest, SERIES_RIVALS * STAGES               each rival's finishing position per round
+    // Positions are stored per round, never accumulated totals: a repeated round REPLACES its result, so the stock
+    // race menu's Retry cannot inflate anyone's points (audit F05). Points, wins and the last round are summed on read.
+    static SERIES_BLOCK = STAGES + SERIES_RIVALS + SERIES_RIVALS * STAGES;
+    // Блоки серий хранятся ПЛОТНО, по собственному индексу, а не по одному на каждое событие.
+    // До 22.09 массив был EVENTS x SERIES_BLOCK: 170 блоков там, где чемпионатов 34, то есть 136 блоков
+    // по 54 сериализованных байта лежали пустыми. Внешний разбор показал, что при полной длине длинных
+    // событий этого места не хватает: рост общих таблиц до 207 событий оставляет 535 байт против
+    // защитного запаса 1024. Плотная таблица освобождает (170-34) x 54 = 7344 байта.
+    // Список идентификаторов литералом; scripts/check_id_registry.py сверяет его с каталогом и падает при расхождении.
+    // Поколение 2 (25.09, события собраны заново): 93 чемпионата, из них 52 звена марафонов. Поздно 25.09 рядом встали
+    // события розничной GT4 (id 200..332, scripts/vanilla_events.py): ещё 40 блоков, всего 133.
+    static SERIES_IDS = [
+                          15, 16, 25, 26, 27, 30, 32, 34, 37, 38, 39, 43, 45, 48, 50, 51, 53, 57, 58, 59,
+                          61, 62, 63, 64, 65, 66, 67, 70, 71, 72, 76, 78, 79, 80, 86, 113, 114, 115, 116, 117,
+                          118, 119, 120, 121, 122, 123, 124, 125, 126, 127, 128, 129, 130, 131, 132, 133, 134, 135, 136, 137,
+                          138, 139, 143, 147, 148, 170, 172, 174, 175, 176, 177, 178, 179, 180, 181, 182, 183, 184, 185, 186,
+                          187, 188, 189, 190, 191, 192, 193, 194, 195, 196, 197, 198, 199, 208, 209, 210, 214, 215, 216, 218,
+                          220, 221, 222, 223, 226, 231, 235, 236, 238, 239, 240, 241, 242, 243, 244, 245, 247, 248, 249, 287,
+                          290, 294, 301, 302, 304, 305, 310, 317, 318, 319, 321, 328, 329 ];
+    static SERIES_SLOTS = 133;
+    static SERIES_BYTES = SERIES_SLOTS * SERIES_BLOCK;
+    static LATCHES = 16;   // permanent unlocks, one byte per hall (audit F06)
+    static ENDURANCE_HALL = 7;
+
+    // Итог марафона: пройденный путь каждого из четверых (игрок, соперники 0..2 трио цикла) за ТЕКУЩИЙ заезд, в
+    // метрах. Бегущая сумма, а не значения по отрезкам: отрезок марафона едется ровно один раз - Retry и Restart
+    // у него сняты, выход посреди прерывает весь заезд БЕЗ подтверждения текущего отрезка.
+    // Это дешевле всех вариантов docs/MARATHON-TOTALS-BUDGET-2026-09-22.md. Путь, а не время: у отрезков по
+    // времени время финиша сентинельное у всех, у отрезков на круги - у отставших; путь живой у всех всегда.
+    // In new timed runs this is centreline progress (lap count plus phase):
+    // seat 1 is negative, encoding -(distance+1) as the format marker. Older
+    // and lap-based runs keep their odometer totals and points classification.
+    // check_id_registry сверяет MARATHONS с каталогом.
+    static MARATHONS = 18;
+    static MARATHON_SEATS = 4;
+    function defineMarathon(st) { st.define("marathon_dist", STArray(STInt(), MARATHONS * MARATHON_SEATS)); }
+    function initMarathon(s) { for (var i = 0; i < MARATHONS * MARATHON_SEATS; i++) s.marathon_dist[i] = 0; }
+    function defineCarLock(st)
+    {
+        st.define("run_car_code", STArray(STLong(), SERIES_SLOTS));
+        st.define("run_car_color", STArray(STShort(), SERIES_SLOTS));
+    }
+    function initCarLock(s)
+    {
+        for (var i = 0; i < SERIES_SLOTS; i++) { s.run_car_code[i] = -1; s.run_car_color[i] = 0; }
+    }
+    function validCarLock(s)
+    {
+        for (var i = 0; i < SERIES_SLOTS; i++)
+            if (s.run_car_color[i] < 0 || (s.run_car_code[i] == -1 && s.run_car_color[i] != 0)) return false;
+        return true;
+    }
+    function carLockMatches(slot, code, color)
+    {
+        if (slot < 0 || slot >= SERIES_SLOTS) return false;
+        var s = get();
+        return s.run_car_code[slot] == -1 || (s.run_car_code[slot] == code && s.run_car_color[slot] == color);
+    }
+    function clearCarLock(id)
+    {
+        var slot = seriesSlot(id);
+        if (slot < 0) return;
+        get().run_car_code[slot] = -1; get().run_car_color[slot] = 0;
+    }
+    function validMarathon(c)
+    {
+        // Seat 0 negative marks withdrawal; seat 1 negative marks the new
+        // centreline-progress format. Both retain the distance as -value-1.
+        for (var i = 0; i < MARATHONS * MARATHON_SEATS; i++)
+            if (c.marathon_dist[i] < 0 && i % MARATHON_SEATS > 1) return false;
+        return true;
+    }
+    function marathonDist(slot, seat)
+    {
+        if (slot < 0 || slot >= MARATHONS || seat < 0 || seat >= MARATHON_SEATS) return 0;
+        var distance = get().marathon_dist[slot * MARATHON_SEATS + seat];
+        return distance < 0 ? -distance - 1 : distance;
+    }
+    function marathonAborted(slot)
+    {
+        return slot >= 0 && slot < MARATHONS && get().marathon_dist[slot * MARATHON_SEATS] < 0;
+    }
+    function marathonMetric(slot)
+    {
+        return slot >= 0 && slot < MARATHONS && get().marathon_dist[slot * MARATHON_SEATS + 1] < 0;
+    }
+    // An old run with odometer totals stays on its old points contract. Only
+    // a run with no confirmed stint may adopt the new distance contract.
+    function marathonBeginMetric(slot)
+    {
+        if (slot < 0 || slot >= MARATHONS || marathonAborted(slot)) return false;
+        if (marathonMetric(slot)) return true;
+        var at = slot * MARATHON_SEATS;
+        for (var i = 0; i < MARATHON_SEATS; i++) if (get().marathon_dist[at + i] != 0) return false;
+        get().marathon_dist[at + 1] = -1;
+        main::GlobalStatus::game_context.need_save = true;
+        return true;
+    }
+    function marathonAbort(slot)
+    {
+        if (slot < 0 || slot >= MARATHONS || marathonAborted(slot)) return;
+        var at = slot * MARATHON_SEATS;
+        get().marathon_dist[at] = -get().marathon_dist[at] - 1;
+    }
+    function marathonAdd(slot, seat, meters)
+    {
+        if (slot < 0 || slot >= MARATHONS || seat < 0 || seat >= MARATHON_SEATS || marathonAborted(slot)) return;
+        if (meters <= 0) return;
+        var at = slot * MARATHON_SEATS + seat;
+        if (seat == 1 && marathonMetric(slot)) get().marathon_dist[at] -= meters;
+        else get().marathon_dist[at] += meters;
+    }
+    function marathonReset(slot)
+    {
+        if (slot < 0 || slot >= MARATHONS) return;
+        for (var seat = 0; seat < MARATHON_SEATS; seat++) get().marathon_dist[slot * MARATHON_SEATS + seat] = 0;
+    }
+
+    // Catalog epochs (audit F08). The journal addresses a result by (event id, stage index); when the catalog's meaning
