+            // stock, while cachedTuned prepares the installed configuration independently.
+            var base = CareerNativeTurbo::prepareStock(parts, cp);
+            root.shop_stock = [base == nil ? -1 : stockPower(base), stockWeight(cp)];
+        }
+        var ps = root.shop_stock[0]; var weight = root.shop_stock[1];
+        // Left column: car, name, spec panel (stock -> fitted), preview of the focused row's choice, parts-fitted bar.
+        var car = root["TuneCar"]; car.visible = true; root.setImage(context, car, "car/thumbnail_L/%s.00".format(main::gtengine::MSpecDB::getCarLabel(code)));
+        foreach (var lit in ["TuneName", "SpecLabel0", "SpecLabel1", "SpecBefore0", "SpecBefore1", "SpecArrow0", "SpecArrow1", "SpecAfter0",
+                             "SpecAfter1", "SpecRule", "PreviewLabel", "PreviewValue", "FittedLabel", "FittedCount"]) root[lit].visible = true;
+        root["TuneName"].T.text = main::gtengine::MSpecDB::getCarShortName(code);
+        root.setPanel(root["SpecPanel"], 18, 154, 145, 54);
+        root["SpecLabel0"].text = "POWER"; root["SpecLabel1"].text = "WEIGHT";
+        root["SpecBefore0"].text = powerText(context, root, ps); root["SpecBefore1"].text = "%d kg".format(weight);
+        root["SpecArrow0"].text = "->"; root["SpecArrow1"].text = "->";
+        root["SpecAfter0"].text = powerText(context, root, cachedTuned(root, cp, tune));
+        // Not tune[1]: that is the legacy multiplier, and a native weight stage leaves it at 100 (CareerProgress::massPct).
+        root["SpecAfter1"].text = "%d kg".format((weight * CareerProgress::massPct(parts, main::Career::tuneSlot(code, color, false), -1, 0) + 50) / 100);
+        root["FittedLabel"].text = "Parts fitted";
+        // Fill every chip of this car before the rows are drawn. A full redraw happens on entry, on a car change
+        // and after a purchase - the three moments the player already expects to wait - and between them the
+        // cursor moves over a warm cache. The arrow keys used to pay for this one cold figure at a time.
+        warmChips(root, cp, code, color, parts, tune);
+        root["FittedCount"].text = "%d / %d".format(drawSegments(root, code, color, parts), main::Career::TUNE_TYPES);
+        drawWindow(context, root, profile);
+    }
+
+    // The parts-fitted bar: one segment per TYPE, orange for a fitted stage, gold for the top stage of that part.
+    // Returns how many types are fitted. Drawn on refresh only - a purchase redraws the page, the cursor never moves it.
+    function drawSegments(root, code, color, parts)
+    {
+        var fitted = 0;
+        for (var t = 0; t < main::Career::TUNE_TYPES; t++)
+        {
+            var list = stageList(parts, t); var stage = CareerProgress::tuneStage(code, color, t);
+            var top = 0; if (list != nil) foreach (var entry in list) if (entry[0] > top) top = entry[0];
+            if (stage > 0) fitted++;
+            root["Seg%d".format(t)].visible = true; root["SegOn%d".format(t)].visible = stage > 0 && stage < top; root["SegTop%d".format(t)].visible = stage > 0 && stage >= top;
+        }
+        return fitted;
+    }
+
+    // The seven visible rows drawn whole, then the chip frame, the hint word and the highlight. Entry, a scroll and
+    // every purchase come through here; a cursor move inside the window redraws two rows (cursorTo).
+    function drawWindow(context, root, profile)
+    {
+        var cp = main::GlobalStatus::game_context.getCar(); var code = cp.getCarCode(); var color = cp.color;
+        var parts = cachedParts(root, cp); var tune = main::Career::tuneFactors(code, color);
+        var weight = root.shop_stock == nil ? stockWeight(cp) : root.shop_stock[1];
+        hint_word = "Buy"; focus_chip = -1; focus_y = 0;
+        // Chips belong to a type and travel with it: the types outside the window put theirs away first.
+        for (var t = 0; t < main::Career::TUNE_TYPES; t++) if (t < first_type || t >= first_type + ROWS) hideChips(root, t);
+        for (var i = 0; i < ROWS; i++) drawRow(context, root, cp, code, color, parts, tune, weight, first_type + i, i);
+        finishCursor(root);
+    }
+
+    // What every redraw ends with: the hint word, the orange chip frame on the focused row's chosen stage, and the
+    // highlight and focus on the focused row's slot in the window.
+    function finishCursor(root)
+    {
+        root["HintLabel1"].text = hint_word;
+        var fr = root["ChipFocus"];
+        if (focus_chip >= 0) { fr.visible = true; fr.x = 271 + focus_chip * 19 - 2; fr.y = focus_y + 5 - 2; root.setEdges(fr, 21, 17, 2); }
+        else fr.visible = false;
+        CareerSuspPage::cursorAt(root, row - first_type);
+    }
+
+    // One row, drawn whole: name, status, chips and - when it is the focused row - the right cell, the preview and the
+    // hint word. Type `t` in visible slot `i`. Split out of refresh() so that moving the cursor redraws two rows instead
+    // of seven rows and every chip on the page (review TUNING-MENU-PERFORMANCE section 2).
+    function drawRow(context, root, cp, code, color, parts, tune, weight, t, i)
+    {
+#ifdef CUP_SMOKE_AUTODRIVE
+        n_row = n_row + 1;
+#endif
+        var green = root.color(0.18, 0.44, 0.18); var grey = root.color(0.35, 0.35, 0.35); var gold = root.color(0.54, 0.42, 0.06);
+        var faint = root.color(0.48, 0.48, 0.48); var dark = root.color(0.1, 0.1, 0.1); var chip = root.color(0.23, 0.23, 0.23); var white = root.color(1.0, 1.0, 1.0);
+        var names = main::CareerParts::types;
+            var key = main::CareerParts::order[t]; var info = names[key];
+            var list = stageList(parts, t); var stage = CareerProgress::tuneStage(code, color, t);
+            var y = 48 + i * 27;
+            root.setPanel(root["StagePanel%d".format(i)], 175, y, 287, 24);
+            var name = root["Stage%d".format(i)]; root.setRect(name, 181, y + 2, 84, 11); name.align = 3; name.text = info["name"];
+            var status = root["StageDetail%d".format(i)]; root.setRect(status, 181, y + 13, 84, 9);
+            var right = root["RowRight%d".format(i)]; root.setRect(right, 370, y + 2, 86, 11); right.T.w = 86; right.T.h = 11; right.T.align = 5; right.T.text = "";
+            // The price cell is shared with the suspension page, which puts it at y + 5 for its own rows: this page
+            // must state its own geometry, or the price lands on top of the stage cell after a visit there
+            // (build_career_layout.py lays it out at 370, y + 12, width 86).
+            var price = root["RowPrice%d".format(i)]; root.setRect(price, 370, y + 12, 86, 11); price.text = "";
+            var cand = list == nil ? nil : candidate(list, t, stage);
+            // Stage chips: default, fitted (green), greyed when a permanent part cannot go back to that stage. They
+            // are the type's own widgets and sit on whichever row the window gives the type.
+            for (var j = 0; j < CHIPS[t]; j++)
+            {
+                var w = root["Chip%d_%d".format(t, j)]; var tx = root["ChipText%d_%d".format(t, j)];
+                w.y = y + 5; tx.y = y + 6;
+                var entry = nil; if (list != nil) foreach (var e in list) if (e[0] == j + 1) entry = e;
+                var show = entry != nil;
+                w.visible = show; tx.visible = show;
+                if (!show) continue;   // the chip loop's own skip: not the end of the row
+                var isFitted = entry[0] == stage; var choosable = CareerProgress::removable(t) || entry[0] > stage;
+                w.FillOn.visible = isFitted;
+                tx.text = chipLabel(info["stages"][entry[0]]);
+                tx.text_color = isFitted ? white : choosable ? chip : faint;
+                if (t == row && cand != nil && cand[0] == entry[0]) { focus_chip = j; focus_y = y; }
+            }
+            if (list == nil)
+            {
+                status.text = "Not available"; status.text_color = faint;
+                if (t == row) { root["PreviewLabel"].T.text = "Not available"; root["PreviewValue"].T.text = "-"; }
+                return;
+            }
+            if (stage > 0 && cand == nil) { status.text = "MAX"; status.text_color = gold; }
+            else if (stage > 0) { status.text = "Installed: %s".format(info["stages"][stage]); status.text_color = green; }
+            else { status.text = "Stock"; status.text_color = grey; }
+            if (t != row) return;
+            // Right cell of the focused row: the chosen stage, its effect and what pressing the confirm button does.
+            if (cand == nil) { right.T.text = "MAX"; right.T.text_color = gold; price.text = ""; root["PreviewLabel"].T.text = "Nothing to buy"; root["PreviewValue"].T.text = "-"; return; }
+            // Native engine rows carry their curve, so their percent is meaningless and hidden. Weight is the
+            // exception: its native row and the catalog carry the SAME donor number, so the percent stays true.
+            right.T.text = "%s  %s".format(info["stages"][cand[0]], (t != 6 && CareerNativeTurbo::isNative(parts, t, cand[0])) ? "" : pctText(t, cand)); right.T.text_color = t == 6 ? root.color(0.1, 0.37, 0.63) : green;
+            // Short form of the design's "With <part> <stage>": the part and its chip label, single-stage parts by name only.
+            root["PreviewLabel"].T.text = info["stages"].size > 2 ? "%s %s".format(info["name"], chipLabel(info["stages"][cand[0]])) : info["name"];
+            // Native weight moves the mass through its SpecDB row, so factors() reports the neutral 100 and the
+            // preview reads the catalog's own tenths of a percent instead (CareerProgress::massPct), the same figure
+            // the spec panel shows once the stage is fitted. Without it the shop told the player the car would weigh
+            // exactly what it weighs now (2026-09-22).
+            if (t == 6)
+                root["PreviewValue"].T.text = "%d kg".format((weight * CareerProgress::massPct(parts, main::Career::tuneSlot(code, color, false), t, cand[0]) + 50) / 100);
