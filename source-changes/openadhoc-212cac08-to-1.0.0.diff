+        var gp = main::GamePlan::createDriftAttack(code, 0, main::RaceOperator.race_parameter.endless);
+        var dp = main::gtengine::MCarDriverParameter(); dp.setDefault(); dp.setPlayer(0);
+        dp.type = main::gtengine::DriverType::GROVE; dp.setGroveAIParameter("max_ai", 100); dp.manual = false;
+        main::Career::return_event = -1;
