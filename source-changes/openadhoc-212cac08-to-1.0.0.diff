+    // Ranges, plus the rule that a fitted tier must be one the record also owns.
+    function validSusp(c, slots, svals)
+    {
+        for (var i = 0; i < slots; i++)
+        {
+            var o = c.susp_owned[i]; var t = c.susp_tier[i];
