+        SoundUtil::BGMFadeout(1.0); StartPageIn_XEffect(context, ROOT, nil); gp.execute(context, 0, [cp], [dp]);
+    }
+#endif
+
+    // Stable measurement fixture, outside the career catalog and journal. No garage insertion or selected-car edit.
+    method startTestOval(context)
