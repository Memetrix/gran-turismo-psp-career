+// Generated by scripts/build_career_market.py; explicit adapted resale quotes live on disk, one file per car,
+// read on demand (nothing resident: memory rules, CLAUDE.md).
+module ::main::CareerMarket
+{
+    function quote(code)
+    {
+        var f = main::pdistd::ReadFile("textdata/career/market/%s.txt".format(main::gtengine::MSpecDB::getCarLabel(code)));
+        if (f == nil || f["result"] != 0) return 0;
+        return f["buffer"].toString().toInt();
+    }
+}
diff -ruN a/scripts/gt5m/CareerParts.ad b/scripts/gt5m/CareerParts.ad
--- a/scripts/gt5m/CareerParts.ad	1970-01-01 00:00:00.000000000 +0000
