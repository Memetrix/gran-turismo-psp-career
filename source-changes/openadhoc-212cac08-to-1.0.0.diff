+        // had said yes to the purchase. The owned branch above needs no such check: ownership is kept in the record.
+        if (!recordAvailable(code, color)) { recordsNote(context); return; }
+        if (profile.cash < cand[1])
+        { note(context, "Not enough credits.\n%s costs %s Cr.".format(partName(info, cand[0]), main::pdiext::MMisc::GetMoneyString(cand[1]))); return; }
+        // Four slots, four arguments: the warning used to be computed and never passed, so the dialog read
+        // "Fitted to ." and the doubt it carried was lost (audit R3). scripts/check_format_args.py now counts these.
+        var warn = "";
+        if (!gain(parts, code, color, t, cand)) warn = t == 6 ? "\nThis stage does not make the car any lighter." : "\nThis stage adds no power on this car.";
+        var cheaper = cheaperEqual(parts, list, t, stage, cand);
+        if (cheaper != nil) warn += "\n%s costs %s Cr. and does %s.".format(info["stages"][cheaper[0]], main::pdiext::MMisc::GetMoneyString(cheaper[1]), doesAsMuch(t, cand, cheaper) ? "as much" : "more");
+        warn += replacementNotice(code, color, t);
+        if (!main::DialogUtil::openConfirmDialog(context, main::DialogUtil::YESNO, "Buy %s for %s Cr.?%s\nFitted to %s.".format(partName(info, cand[0]), main::pdiext::MMisc::GetMoneyString(cand[1]), warn, main::gtengine::MSpecDB::getCarShortName(code)))) return;
+        if (!fitCandidate(context, parts, cp, code, color, t, cand[0])) return;
+        profile.cash -= cand[1];
+        main::GlobalStatus::game_context.need_save = true;
+        dirty = true; pick[t] = 0; dropCaches(root);
+        main::sound.play("ok");
+        refreshWithWait(context, root);
+    }
+
+    function remove(context, root, profile)
+    {
+        var cp = main::GlobalStatus::game_context.getCar(); var code = cp.getCarCode(); var color = cp.color; var t = row;
+        var stage = CareerProgress::tuneStage(code, color, t);
+        if (stage <= 0) { main::sound.play("cancel"); return; }
+        var info = main::CareerParts::types[main::CareerParts::order[t]];
+        if (!CareerProgress::removable(t))
+        { note(context, "%s is a permanent modification.\nIt cannot be removed.".format(info["name"])); return; }
+        if (!main::DialogUtil::openConfirmDialog(context, main::DialogUtil::DEFAULT_NO, "Remove %s?\nIt stays in your inventory; refit it for free.".format(info["name"]))) return;
+        if (!fitCandidate(context, cachedParts(root, cp), cp, code, color, t, 0)) return;
+        dirty = true; pick[t] = 0; dropCaches(root);
+        main::sound.play("ok");
+        refreshWithWait(context, root);
+    }
+}
