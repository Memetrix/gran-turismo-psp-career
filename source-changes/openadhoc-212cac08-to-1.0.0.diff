+            context.translate(ArcadeProject, "SaveDataPSP", "NOW_SAVING"),
+            context.translate(ArcadeProject, "SaveDataPSP", "SAVE_DONE"),
+            context.translate(ArcadeProject, "SaveDataPSP", "SAVE_NOT_DONE"),
+#ifdef CUP_SMOKE_AUTODRIVE
+            function (context, arg)
+            {
+                // Measurement fixture (review of slow saves): GTTopRoot.saveImpl step by step, timed once, no extra pack.
+                var t0 = main::pdistd::GetSystemTimeMicroSecond();
+                main::GlobalStatus::checkin(gGameStatus);
+                var data = main::GlobalStatus::getToBeSavedData();
+                var t1 = main::pdistd::GetSystemTimeMicroSecond();
+                gGameStatus = main::GlobalStatus::checkout();
+                if (data == nil) { game_context().need_save = true; save_count++; save_bytes = 0; return false; }
+                var savedata = SaveDataUtilPSP::GameDataForSaveSilent();
+                savedata.title = context.translate(GTTopRoot, "SaveDataPSP", "GAME_TITLE_WITHIN_128BYTES");
+                savedata.description = context.translate(GTTopRoot, "SaveDataGT5M", "GAME_SUBTITLE_WITHIN_128BYTES");
+                savedata.savedataTitle = context.translate(GTTopRoot, "SaveDataGT5M", "GAME_DESCRIPTION_WITHIN_1024BYTES");
+                savedata.buf = data;
+                var res = SaveDataUtilPSP::save(context, savedata, GTTopRoot);
+                var t2 = main::pdistd::GetSystemTimeMicroSecond();
+                game_context().need_save = !res;
+                save_count++; save_pack_us = t1 - t0; save_total_us = t2 - t1; save_bytes = data.size;
+                return res;
+            }, nil, 2);
+        DialogUtil::openConfirmDialog(context, DialogUtil::OK, "SAVE #%d\npack %d ms, save %d ms, %d bytes\nbuffer %d, natives %d, deflate %d ms\nraw %d bytes, raw saves %d, refused %d".format(save_count, save_pack_us / 1000, save_total_us / 1000, save_bytes,
+            main::SaveTiming::buffer_us / 1000, main::SaveTiming::natives_us / 1000, main::SaveTiming::deflate_us / 1000, main::SaveTiming::raw_bytes, main::SaveHealth::raw_saves, main::SaveHealth::refused_saves));
+#else
+            function (context, arg) { return GTTopRoot.saveImpl(context); }, nil, 2);
+#endif
+        if (ok) game_context().need_save = false;
+        return ok;
+    }
+
+    method saveCareer(context)
+    {
+        // The native wrapper includes credits, garage and career in one save. saveWithDialog clears the flyers.
+        var saved = self.saveWithDialog(context);
+        if (self.flyers_dropped) { self.flyers_dropped = false; self.refresh(context); }
+        if (saved) return;
+        // ONE dialog, never two. A failed save has just proved the game cannot find memory, and every modal page
+        // is itself an allocation; this used to open the low-memory notice and then this one on top of it.
+        DialogUtil::openConfirmDialog(context, DialogUtil::ERROR, main::SaveHealth::refused_saves > 0
+            ? "Not saved: profile exceeds the 256 KB save limit.\nYour previous save is intact."
+            : "Career could not be saved.\nYour progress is still in memory.\nReturn to GT CAREER to retry saving.");
+    }
+
+    method onFinalize(context)
+    {
+        self.dropFlyers(context);
+        BalloonTip.reset_value();
+        context.cursor_visible = true;
+    }
+
+    method setImage(context, widget, path)
+    {
+        if (widget.image_path != path)
+        {
+            widget.image_path = path;
+            widget.doInitialize(context);
+        }
+    }
+
+    // Art0..3 show hall panels and hall banners from CareerRoot.gpb, and event flyers (art key card_<n>) as standalone
+    // pictures in piece_gt5m/mission_flyer (build_career_art.py), streamed like the licence screens' mission flyers.
+    // Keeping flyers out of every bundle is the point: in CareerRoot.gpb they cost the save its 350 KB block, and
+    // per-hall bundles crashed career entry (25.09). Only the flyers on screen hold memory, uncached.
+    method artImage(context, widget, path)
+    {
+        if (widget.image_path != path)
+        {
+            var disk = path.beginWith("piece_gt5m/");
+            // A streamed flyer gets the TuneCar lifetime: nothing kept once the widget shows something else.
+            if (disk) { widget.cache = false; widget.block = false; }
+            widget.from_disk = disk;
+            widget.image_path = path;
+            widget.doInitialize(context);
+        }
+    }
+
+    method eventArt(context, widget, e)
+    {
+        var art = e["art"];
+        self.artImage(context, widget, art.beginWith("card_")
+            ? "piece_gt5m/mission_flyer/career_%s.img".format(art) : "image/career/events/%s.png".format(art));
+    }
+
+    // Before a save and a race: every Art widget holding a streamed flyer lets its texture go. True when one did.
+    method dropFlyers(context)
+    {
+        var dropped = false;
+        for (var i = 0; i < 4; i++)
+        {
+            var w = ROOT["Art%d".format(i)];
+            var path = w.image_path;
+            if (path != nil && path.beginWith("piece_gt5m/")) { w.image_path = ""; w.doInitialize(context); dropped = true; }
+        }
+        return dropped;
+    }
+
+    method color(r, g, b) { return main::menu::MColorObject(r, g, b, 1.0); }
+
+    // An event's licence is a PSP Driving Challenge group index (LicenseUtil CATEGORY: 0 = Group A .. 5 = Group F), and
+    // licenceName gives the GT4 letter it stands for. They are NOT the same letters: GT4 B is Group A, A is Group B,
+    // IB is D, IA is E and S is F (build_career_catalog.py maps RACE.License 1..5 onto 0, 1, 3, 4, 5; C is never used).
+    // Players met only the GT4 letters and looked for an "IA" test the PSP does not have (beta feedback, 2026-09-25),
+    // so everything a player reads names the PSP group first.
+    method licenceName(cat) { return ["B", "A", "IC", "IB", "IA", "S"][cat]; }
+    method groupName(cat) { return LicenseUtil::GetCategoryString(cat); }
+
+    // What is left before the Driving Challenge group `cat` counts as cleared, in the PSP's own words: the untried tests
+    // of the first unfinished group on the stock route to it (LicenseUtil::EntryCondition), then the groups after it.
+    // Where the route forks (D opens after B or C) the cleared branch is taken, otherwise B, which licence A needs anyway.
+    // Read from the stock records on demand; nothing is kept.
+    method licenceTodo(cat)
+    {
+        var route = [cat];
+        var g = cat;
+        while (LicenseUtil::EntryCondition[g] != nil)
+        {
+            var cond = LicenseUtil::EntryCondition[g];
+            if (cond.isInstanceOf(System::Array))
+            {
+                g = cond[0];
+                for (var i = cond.size - 1; i >= 0; i--) if (self.licensed(cond[i])) g = cond[i];
+            }
+            else g = cond;
+            route.push(g);
+        }
+        var records = gGameStatus.user_profile.record.licenses;
+        var text = "";
+        var later = [];
+        for (var r = route.size - 1; r >= 0; r--)
+        {
+            var c = route[r];
+            if (self.licensed(c)) continue;
+            if (text != "") { later.push(self.groupName(c)); continue; }
+            var missing = [];
+            for (var i = 0; i < 6; i++)
+                if (records[LicenseUtil::GetIndex(c, i)].result == LicenseUtil::PRIZE::NONE) missing.push("%s-%d".format(self.groupName(c), i + 1));
+            if (missing.size == 0 || missing.size == 6) text = "Group " + self.groupName(c);
+            else if (missing.size > 3) text = "%d tests in Group %s".format(missing.size, self.groupName(c));
+            else
+            {
+                text = missing[0];
+                for (var i = 1; i < missing.size; i++) text += (i == missing.size - 1 ? " and " : ", ") + missing[i];
+            }
+        }
+        if (later.size > 0)
+        {
+            text += later.size == 1 ? ", then Group " : ", then Groups ";
+            for (var i = 0; i < later.size; i++) text += (i == 0 ? "" : i == later.size - 1 ? " and " : ", ") + later[i];
+        }
+        return text;
+    }
+
+    // Long car names on the event card take two single-line fields, split after the maker word (a TextFace does not
+    // break on a newline here and there is no string width API; the clipping container cuts what is still too long).
+    // Заголовок верхней плашки. От x=22 до «Day» (x≈282) на штатном масштабе 1.25 помещается около 27 знаков
+    // (замер 23.09: «Nurburgring 24h Endurance» - 233 px на 25 знаков). В каталоге 25.09 длиннее 26 знаков 7 имён из
+    // 170: пять «(Part N)» частей цепочек и два обычных (European Touring Championship, Hidden Course Test - Tarmac);
+    // без ужатия они налезали бы на день.
+    // Масштаб ужимается по длине, но не мельче 0.85 - масштаба подписей нижней плашки, которые читаются.
+    // Выравнивание 3 центрирует текст по вертикали, так что меньший масштаб остаётся на своей строке.
+    method setTitle(text)
+    {
+        var s = 1.25;
+        if (text.size > 26) s = 1.25 * 26.0 / text.size;
+        if (s < 0.85) s = 0.85;
+        Title.scale_x = s; Title.scale_y = s; Title.text = text;
+    }
+
+    method splitName(name)
+    {
+        var words = name.split(" ");
+        if (words.size < 3) return [name, ""];
+        var rest = words[1];
+        for (var i = 2; i < words.size; i++) rest = rest + " " + words[i];
+        return [words[0], rest];
+    }
+    method licensed(cat) { return cat < 0 || gGameStatus.user_profile.cleared_license_category[cat]; }
+
+    method setEdges(f, w, h, t)
+    {
+        f.w = w; f.h = h;
+        f.Top.w = w; f.Top.h = t; f.Bottom.w = w; f.Bottom.h = t; f.Bottom.y = h - t;
+        f.Left.w = t; f.Left.h = h; f.Right.w = t; f.Right.h = h; f.Right.x = w - t;
+    }
+
+    method setFrame(f, x, y, w, h)
+    {
+        f.visible = true; f.x = x; f.y = y; self.setEdges(f, w, h, 1);
+    }
+
+    method setPanel(p, x, y, w, h)
+    {
+        p.visible = true; p.x = x; p.y = y; p.w = w; p.h = h;
+        p.Border.w = w; p.Border.h = h; p.Fill.w = w - 2; p.Fill.h = h - 2;
+    }
+
+    // A widget shown at a rectangle: the five assignments every card, icon and row cell used to spell out in place
+    // (one copy of them in the bundle; the pages call it as root.setRect).
+    method setRect(f, x, y, w, h) { f.visible = true; f.x = x; f.y = y; f.w = w; f.h = h; }
+
+    method setHighlight(x, y, w, h)
+    {
+        // Card rect expanded by 3: 1 px dark ring outside a 2 px orange frame.
+        Highlight.x = x - 3; Highlight.y = y - 3; Highlight.w = w + 6; Highlight.h = h + 6;
+        self.setEdges(Highlight.Outer, w + 6, h + 6, 1);
+        Highlight.Inner.x = 1; Highlight.Inner.y = 1; self.setEdges(Highlight.Inner, w + 4, h + 4, 2);
+    }
+
+    method refresh(context)
+    {
+        // All career art belongs to this root's native GPB lifetime.
+        // Do not unload textures while ImageFaces / pending GE draws reference them.
+        var confirm = main::pdiext::MSystemConfiguration::GetEnterButtonAssign();
+        var back = confirm == "cross" ? "circle" : "cross";
+        var pair = self.page >= 2;
+        var glyphs = [pair ? "up" : "left", confirm, back, "triangle", "square", "r"];
+        var labels = ["Select", self.page == 2 ? "Race" : "Open", "Back", "Garage", "Rules", "Tune"];
+        var shown = self.page == 2 ? 6 : 3;
+#ifdef CUP_SMOKE_AUTODRIVE
+        if (self.page == 0) { labels[3] = "START: Oval"; glyphs[3] = "triangle"; shown = 4; }
+#endif
+#ifdef CUP_SMOKE_DRIFT
+        if (self.page == 0) labels[3] = "START: Drift";
+#endif
+        if (self.page == 3) { labels = ["Scroll", "Page", "Back", "", "", ""]; glyphs = ["up", "left", back, "", "", ""]; }
+        // Two whole pages hang off the shoulder buttons here, and neither was on screen: the sixth hint was drawn
+        // at x=476 of a 480-wide screen (page 4 used a 92 px pitch), and the tyre page had no hint at all. Both
+        // are named now at the 76 px pitch that fits six, and "Stage" gives up its slot: the stage chips are
+        // drawn on the row itself, while a page nobody can see does not exist (Алексей, 2026-09-20).
+        if (self.page == 4) { labels = ["Select", "Buy", "Back", "Remove", "", "Susp", "Tyres"]; glyphs = ["up", confirm, back, "square", "", "l", "r"]; shown = 7; }   // "r" is the glyph the event page already draws; "l" is its pair
+        if (self.page == 5) { labels = ["Select", "Fit", "Back", "", "Adjust", ""]; glyphs = ["up", confirm, back, "", "right", ""]; shown = 5; }
+        if (self.page == 6) { labels = ["Select", "Buy", "Back", "", "", ""]; glyphs = ["up", confirm, back, "", "", ""]; shown = 3; }
+        // Slot 5 is the trigger slot the layout reserves; page 4 is the only page that needs both of them.
+        if (self.page == 2 && self.stage == main::CareerCatalog::eventInfo(self.event_id)["stages"].size)
+        {
+            labels[1] = ["Open", "New run", "Restart"][self.actionMode()];
+        }
+        // Slot 5 (R Tune) is laid out hidden and touched only once shown: widgets the root never
+        // needs at init must not be written to during init, or stray kernel blocks land in the
+        // race arena region (docs/TUNING-RESEARCH.md, memory investigation).
+        var slots = CareerTuningPage::hintSlots(shown);
+        for (var h = 0; h < slots; h++)
+        {
+            var icon = ROOT["HintIcon%d".format(h)]; var label = ROOT["HintLabel%d".format(h)];
+            var show = h < shown;
+            icon.visible = show; label.visible = show;
+            // Latched trigger slots outnumber this page's label list (six entries; page 4 alone has seven):
+            // they are hidden above and must not be read past. labels[6] here fed garbage to the native text
+            // setter - the emulator shrugged, the console crashed on any page after one tuning-shop visit.
+            if (h >= labels.size) continue;
+            if (show) self.setImage(context, icon, "image/gt5m/option/%s.png".format(glyphs[h]));
+            label.text = labels[h];
+            var pitch = self.page == 2 ? 76 : 92;
+            if (self.page == 4)
+            {
+                // Hand-placed: four actions on a tighter pitch, then the two trigger glyphs, which are 40 px wide
+                // and need their label beside them. At the uniform pitch the sixth slot started at x=476 of 480
+                // and nobody ever saw it.
+                var sx = [16, 86, 156, 226, 0, 300, 382]; var lx = [36, 106, 176, 246, 0, 344, 426];
+                icon.x = sx[h]; label.x = lx[h];
+            }
+            else { icon.x = 16 + h * pitch; label.x = h >= 5 ? icon.x + 44 : 36 + h * pitch; }
+        }
+#ifdef CUP_SMOKE_AUTODRIVE
+        if (self.page == 0) { HintIcon3.visible = false; HintLabel3.x = 310; HintLabel3.w = 105; }
+        else HintLabel3.w = 60;
+#endif
+        // Paired arrows for Select / Scroll overlap like the stock hint strip.
+        HintIcon0.x = 14; Direction2.x = 23; HintLabel0.x = 44;
+        self.setImage(context, Direction2, "image/gt5m/option/%s.png".format(pair ? "down" : "right"));
+        Day.text = context.translate(ROOT, "Arcade", "GAME_DAY").build(gGameStatus.user_profile.calendar.getGameDay() + 1);
+        Cash.text = main::pdiext::MMisc::GetMoneyString(gGameStatus.user_profile.cash);
+        ExitButton.visible = self.page == 0;
+        // Every page-specific widget off, by name (all direct children of this root): one loop in the bundle instead
+        // of twenty-two statements.
+        foreach (var hidden in ["Highlight", "StatusPanel", "InfoPanel", "ThumbFrame", "PrizeIcon", "Info", "PrizeCarImage", "GoldIcon",
+                                "CarStatus", "CarSep", "Car", "ListTitle", "Counter", "Rule", "RuleLabel0", "RuleValue0", "RuleLabel1",
+                                "RuleValue1", "RuleLabel2", "RuleValue2", "RuleValue3", "InfoLine0b"]) ROOT[hidden].visible = false;
+        for (var i = 0; i < 4; i++)
+        {
+            ROOT["Art%d".format(i)].visible = false; ROOT["CapIcon%d".format(i)].visible = false;
+            ROOT["Caption%d".format(i)].visible = false; ROOT["Tag%d".format(i)].visible = false;
+            ROOT["CardFrame%d".format(i)].visible = false; ROOT["InfoLine%d".format(i)].visible = false;
+        }
+        // Семь строк, а не шесть: у шестиэтапного события строка действия - седьмая (StagePanel6/Stage6), и
+        // прятал её только leave() магазина, который без визита в магазин ничего не делает. Она оставалась на
+        // странице правил и в зале после любого из 51 шестиэтапного события. LogoTile - только у этапов, их шесть.
+        for (var i = 0; i < 7; i++)
+        {
+            ROOT["StagePanel%d".format(i)].visible = false; ROOT["CourseLogo%d".format(i)].visible = false;
+            ROOT["Stage%d".format(i)].visible = false; ROOT["StageDetail%d".format(i)].visible = false; ROOT["Medal%d".format(i)].visible = false;
+            if (i < 6) ROOT["LogoTile%d".format(i)].visible = false;
+        }
+        // Only on a real page change: these hide the other page's widgets, and the tuning one also drops the
+        // per-visit caches. Running them before every redraw meant no cache survived a single key press
+        // (review TUNING-MENU-PERFORMANCE section 3).
+        if (self.drawn_page != self.page)
+        {
+            CareerTuningPage::leave(ROOT); CareerSuspPage::leave(ROOT); CareerTirePage::leave(ROOT);
+            // Hopping between the shop, the suspension page and the tyre page keeps the shop's caches; leaving the
+            // shop area frees them, because nothing of a menu may still be alive when the race asks for its 6.9 MB
+            // arena. The tyre page reads the same per-car catalog, so it belongs inside the same whitelist.
+            if (self.page != 4 && self.page != 5 && self.page != 6) CareerTuningPage::dropCaches(ROOT);
+            self.drawn_page = self.page;
+        }
+        if (self.page != 1 && self.page != 2) self.dropFlyers(context);   // only the event list and page draw flyers
+        context.cursor_visible = self.page != 3 && !self.prize_open;
+        if (self.page == 3) { ROOT.setFocus(Input); self.refreshRules(context); return; }
+        if (self.page == 4) { CareerTuningPage::refresh(context, ROOT, gGameStatus.user_profile); return; }
+        if (self.page == 5) { CareerSuspPage::refresh(context, ROOT, gGameStatus.user_profile); return; }
+        if (self.page == 6) { CareerTirePage::refresh(context, ROOT, gGameStatus.user_profile); return; }
+        if (self.page == 0)
+        {
+            var pages = (main::CareerCatalog::HALLS + 3) / 4;
+            self.setTitle(pages > 1 ? "GT Career  %d / %d".format(self.hall_start / 4 + 1, pages) : "GT Career");
+            var sel = self.category - self.hall_start;
+            for (var i = 0; i < 4; i++)
+            {
+                var id = self.hall_start + i;
+                if (id >= main::CareerCatalog::HALLS) continue;
+                var hall = main::CareerCatalog::hallInfo(id);
+                var w = ROOT["Art%d".format(i)];
+                self.setRect(w, 14 + i * 117, 44, 112, 150);
+                self.artImage(context, w, "image/career/sections/%s.png".format(hall["art"]));
+                if (i != sel) self.setFrame(ROOT["CardFrame%d".format(i)], w.x - 1, w.y - 1, 114, 152);
+                // Соревнования, а не звенья: промежуточная часть завершённой не бывает, и эндуранс показывал
+                // «x / 52» при потолке 18. tails - звено, чей cleared решает соревнование: ни одного файла события.
+                var complete = 0;
+                foreach (var e in hall["tails"]) if (main::Career::get().cleared[e]) complete++;
+                var icon = ROOT["CapIcon%d".format(i)]; self.setRect(icon, w.x + 2, 200, 13, 12);
+                self.setImage(context, icon, "image/gt5m/icon/status_gold.png");
+                var t = ROOT["Caption%d".format(i)]; self.setRect(t, w.x + 19, 198, 93, 14);
+                t.text = "%d / %d".format(complete, hall["heads"].size);
+            }
+            self.setHighlight(14 + sel * 117, 44, 112, 150);
+            ROOT.setFocus(ROOT["Art%d".format(sel)]);
+            self.tipHall(context);
+        }
+        else if (self.page == 1)
+        {
+            // Зал показывает соревнования (головы цепочек): части длинного живут внутри него, на странице 7.
+            var hall = main::CareerCatalog::hallInfo(self.category); var list = hall["heads"]; var pages = (list.size + 3) / 4;
+            // The list can be shorter than the cursor remembers (a hall read again from a changed file): pull the
+            // cursor back inside it before anything below indexes it (review F1).
+            if (self.page_start >= list.size) self.page_start = 0;
+            if (self.page_start + self.selected >= list.size) self.selected = 0;
+            self.setTitle(pages > 1 ? "%s  %d / %d".format(hall["name"], self.page_start / 4 + 1, pages) : hall["name"]);
+            var shown = list.size - self.page_start; if (shown > 4) shown = 4;
+            for (var i = 0; i < shown; i++)
+            {
+                var id = list[self.page_start + i]; var e = main::CareerCatalog::eventInfo(id);
+                var w = ROOT["Art%d".format(i)]; self.setRect(w, 18 + (i % 2) * 226, 46 + (i / 2) * 95, 216, 76);
+                self.eventArt(context, w, e);
+                if (i != self.selected) self.setFrame(ROOT["CardFrame%d".format(i)], w.x - 1, w.y - 1, 218, 78);
+                // Карточка длинного соревнования - это всё соревнование: золото по всем частям, COMPLETED по звену,
+                // которое платит приз (у промежуточной части cleared не бывает), и число частей там, где стояло бы
+                // COMPLETED, пока соревнование не выиграно. Всё из строки головы и журнала, файлы частей не читаются.
+                var parts = e["chain_parts"]; var chain = parts.size > 0;
+                var total = chain ? e["chain_stages"] : e["stages"].size;
+                var golds = chain ? CareerProgress::chainGold(parts, total) : CareerProgress::goldCount(id, total);
+                // Закрытое продолжение занимает те же два виджета, что и счёт золота: карточка у него
+                // обычная, а не особая, и отдельной семьи виджетов под замок не заводится (правило шага).
+                // Зал показывает только головы, у них предшественника нет; проверка остаётся на случай битого файла.
+                var open = CareerProgress::chainOpen(e["requires"]);
+                var icon = ROOT["CapIcon%d".format(i)]; self.setRect(icon, w.x + 2, w.y + 79, 12, 11);
+                self.setImage(context, icon, "image/gt5m/icon/status_%s.png".format(golds > 0 && open ? "gold" : "silver"));
+                var t = ROOT["Caption%d".format(i)]; self.setRect(t, w.x + 18, w.y + 78, 84, 13);
+                t.text = open ? "%d / %d gold".format(golds, total) : "LOCKED";
